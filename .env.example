# Example values only. Set real secrets in your local environment or host settings.
TWILIO_AUTH_TOKEN=replace_with_your_twilio_auth_token
TWILIO_VALIDATE_SIGNATURE=false
GOLDENGUARD_PUBLIC_BASE_URL=http://localhost:8000

# The SMS webhook uses a separate companion member-account service.
GOLDENGUARD_MEMBER_LOOKUP_URL=https://example.org/api/internal/member-profile
GOLDENGUARD_MEMBER_LOOKUP_SECRET=replace_with_your_shared_secret

# Local test-only mode; real member records are not included.
GOLDENGUARD_ALLOW_LOCAL_PROFILES=false
GOLDENGUARD_PHONE_PROFILES=data/phone_profiles.json
GOLDENGUARD_SMS_INCLUDE_URLS=true
GOLDENGUARD_SMS_MAX_CHARS=306

# Sample Twilio identifiers, not production credentials.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+15555550123

GOLDENGUARD_SMS_HISTORY_URL=https://example.org/api/internal/sms-history
